{
    "tasks": [
        {  //I defined this "BUILD" task
            "label": "BUILD",  //name your task anything
            "type": "shell",
            "command": "g++",  //using g++ compiler
            "args": [
                "-g",  //-g for debugging
                "SerialPC.h",  //all .h and .cpp files in workspace
                "SerialPC.cpp",
                "${fileBasename}",
                "-o", "${fileBasenameNoExtension}",  //to name the output file as "cppfilename.exe"
            ],
            "group": {  //group your task
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
